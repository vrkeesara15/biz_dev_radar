# --- Auth.js -----------------------------------------------------------------
# Shared with the backend, which verifies API bearer tokens with HS256.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Set to true when not on Vercel (Docker, Cloud Run) so Auth.js trusts the Host header.
AUTH_TRUST_HOST=true
# Public URL of this app (used for magic-link callbacks).
AUTH_URL=http://localhost:3000

# Email magic link (Nodemailer). Local: Mailpit from infra/docker-compose.yml.
# NOTE: enabling email attaches the dev-only in-memory adapter (src/lib/auth-adapter.ts).
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=BidRadar <no-reply@bidradar.local>

# Google OAuth (leave empty to hide the button)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID OAuth (leave empty to hide the button)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0  (omit for multi-tenant "common")
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Dev-only membership fallback (TODO: replaced by resolveMembership -> backend)
BIDRADAR_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
BIDRADAR_DEV_ROLE=tenant_owner

# --- Backend API ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by `pnpm gen:api` when ../backend/openapi.json is absent
API_URL=http://localhost:8000

# --- Deployment region badge: US | IN ------------------------------------------
NEXT_PUBLIC_REGION=US
