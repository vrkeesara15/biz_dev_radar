# --- Auth.js -----------------------------------------------------------------
# Shared with the backend, which verifies API bearer tokens with HS256.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Set to true when not on Vercel (Docker, Cloud Run) so Auth.js trusts the Host header.
AUTH_TRUST_HOST=true
# Public URL of this app (used for magic-link callbacks).
AUTH_URL=http://localhost:3000

# Email magic link (Nodemailer). Local: Mailpit from infra/docker-compose.yml.
# NOTE: enabling email attaches the dev-only in-memory adapter (src/lib/auth-adapter.ts).
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=BidRadar <no-reply@bidradar.local>

# Google OAuth (leave empty to hide the button)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID OAuth (leave empty to hide the button)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0  (omit for multi-tenant "common")
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- DEMO-ONLY sign-in (no password, no proof of address ownership) -------------
# Set AUTH_DEV_LOGIN=1 ONLY for a throwaway demo with no real tenant data. It adds an
# Auth.js Credentials provider ("dev-login") that issues a session to any address in
# AUTH_DEV_LOGIN_EMAILS, with no password. Both must be set: the flag alone registers
# nothing. Switch to Google or Microsoft OAuth before anyone real signs in.
AUTH_DEV_LOGIN=
AUTH_DEV_LOGIN_EMAILS=

# --- Dev-only membership fallback (TODO: replaced by resolveMembership -> backend)
BIDRADAR_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
BIDRADAR_DEV_ROLE=tenant_owner

# --- Backend API ---------------------------------------------------------------
# API_URL is read at RUNTIME by src/lib/api/client.ts and WINS over NEXT_PUBLIC_API_URL
# (OQ-77). Only the server uses it: client components call /api/v1/... on this origin
# and src/app/api/v1/[...path]/route.ts proxies them. Because it is a plain variable,
# one image can serve several environments — Next inlines NEXT_PUBLIC_* at BUILD time,
# so that one cannot. On Railway: API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080.
# It is also the spec source for `pnpm gen:api` when ../backend/openapi.json is absent.
API_URL=http://localhost:8000
# Build-time fallback, used only when API_URL is unset. Also the Docker build arg
# (NEXT_PUBLIC_API_BASE_URL is its deprecated alias).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deployment region badge: US | IN ------------------------------------------
NEXT_PUBLIC_REGION=US
