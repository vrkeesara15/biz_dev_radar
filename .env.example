# BidRadar settings. Copy to backend/.env (never commit .env). Every key here maps to a
# field in backend/app/core/config.py; tests/unit/test_env_example.py keeps them in sync.

# --- runtime
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- database and cache (compose host ports: postgres 5433, redis 6380)
# Application role (non-owner, RLS enforced) and owner role (migrations, admin bypass).
DATABASE_URL=postgresql+asyncpg://bidradar_app:bidradar_app@localhost:5433/bidradar
DATABASE_URL_OWNER=postgresql+asyncpg://bidradar:bidradar@localhost:5433/bidradar
REDIS_URL=redis://localhost:6380/0
# Celery: run tasks inline instead of through the broker (tests / single-process dev)
CELERY_TASK_ALWAYS_EAGER=false
# seconds the admin "run now" endpoint waits for the broker before running inline
CELERY_BROKER_CONNECT_TIMEOUT=2.0

# --- files (local | s3 | gcs); S3-compatible store (RustFS, MinIO-compatible) on 9000 (API) / 9001 (console)
# One bucket per data-residency region (SPEC section 11); local backend writes under LOCAL_STORAGE_ROOT/<region>.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.storage
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_US=bidradar-us
S3_BUCKET_IN=bidradar-in
GCS_BUCKET_US=bidradar-us
GCS_BUCKET_IN=bidradar-in
# signed download URL lifetime (SPEC section 11: short-lived)
SIGNED_URL_EXPIRES_SECONDS=900
# virus scan before parsing: clamav in deployed images, noop only for local/tests
SCANNER_BACKEND=noop
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_UNIX_SOCKET=
# OCR for scanned PDF pages: tesseract in deployed images (binary + eng/hin data), none locally
OCR_BACKEND=none
OCR_LANGUAGES=eng+hin
TESSERACT_CMD=

# --- residency: us | in
REGION=us

# --- auth and crypto (Auth.js shares AUTH_SECRET; generate with `openssl rand -base64 32`)
AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
# base64 of 32 random bytes for AES-256-GCM field encryption: `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=
AUTH_RATE_LIMIT_PER_MINUTE=20
# true only behind a proxy that sets X-Forwarded-For (Cloud Run); false for local/dev
TRUST_PROXY_HEADERS=false

# --- contact shown in User-Agent and notices
CONTACT_EMAIL=ops@example.com

# --- third-party keys (leave empty locally; tests never call the network)
SAM_API_KEY=
ANTHROPIC_API_KEY=
# requests per UTC day the SAM.gov key may spend (non-federal personal keys are low)
SAM_DAILY_QUOTA=10
# contract awards search endpoint and the comma-separated NAICS list the daily awards job asks for
SAM_AWARDS_API_URL=https://api.sam.gov/contract-awards/v1/search
# entity registration lookup by UEI (profile autofill)
SAM_ENTITY_API_URL=https://api.sam.gov/entity-information/v3/entities
SAM_AWARDS_NAICS=

# --- polite HTTP client (SPEC 5.1): token bucket per host, backoff, timeout
HTTP_DEFAULT_RATE_PER_SEC=2.0
HTTP_GOV_IN_RATE_PER_SEC=1.0
# JSON map host -> req/s overrides, e.g. {"api.sam.gov": 0.5}
HTTP_RATE_LIMITS={}
HTTP_MAX_ATTEMPTS=5
HTTP_TIMEOUT_SECONDS=30

# --- LLM model classes (SPEC section 8). Only config.py may hold these literals.
LLM_MODEL_OPUS_CLASS=claude-opus-5
LLM_MODEL_SONNET_CLASS=claude-sonnet-5
LLM_MODEL_HAIKU_CLASS=claude-haiku-4-5
LLM_MODEL_RATIONALE=claude-sonnet-5
# JSON map model id -> {input, output, cache_read, cache_write} USD per million tokens; empty = defaults in config.py
LLM_PRICES={"claude-opus-5": {"input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25}, "claude-sonnet-5": {"input": 2, "output": 10, "cache_read": 0.2, "cache_write": 2.5}, "claude-haiku-4-5": {"input": 1, "output": 5, "cache_read": 0.1, "cache_write": 1.25}}
LLM_MAX_TOKENS=4096
LLM_OUTPUT_RETRIES=2

# --- embeddings (voyage | fake), 1024 dims; texts are embedded in batches of EMBEDDING_BATCH_SIZE
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=128
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings

# --- money: JSON map of currency -> USD rate used by core.money.to_usd (every currency, USD
# included, needs an entry). Static until the FX refresh job lands (PROGRESS.md OQ-22).
FX_RATES={"USD": 1.0, "INR": 0.012}

# --- billing (SPEC 10.1): Stripe for us tenants (USD), Razorpay for in tenants (INR with GST
# invoices). Price/plan id maps are JSON {plan: provider id}; webhooks are verified by signature.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com/v1
STRIPE_PRICE_IDS={}
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_PLAN_IDS={}
# our GSTIN (supplier of record on Indian invoices) and the GST rate for SaaS (SAC 998314)
BILLING_GSTIN=
BILLING_GST_RATE_PCT=18

# --- privacy (SPEC 11): DPDP consent notice, data-principal requests, grievance officer.
# Bump a version when the notice text changes; the next acceptance writes a new consent row.
DPDP_NOTICE_VERSION=v1
PRIVACY_POLICY_VERSION=v1
TERMS_VERSION=v1
DATA_REQUEST_SLA_DAYS=30
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# --- seed (make seed)
SEED_ADMIN_EMAIL=admin@example.com

# --- observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
