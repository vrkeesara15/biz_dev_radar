# BidRadar settings. Copy to backend/.env (never commit .env). Every key here maps to a
# field in backend/app/core/config.py; tests/unit/test_env_example.py keeps them in sync.

# --- runtime
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- database and cache (compose host ports: postgres 5433, redis 6380)
# Application role (non-owner, RLS enforced) and owner role (migrations, admin bypass).
DATABASE_URL=postgresql+asyncpg://bidradar_app:bidradar_app@localhost:5433/bidradar
DATABASE_URL_OWNER=postgresql+asyncpg://bidradar:bidradar@localhost:5433/bidradar
REDIS_URL=redis://localhost:6380/0

# --- files (local | s3 | gcs); MinIO on 9000 (API) / 9001 (console)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bidradar-local

# --- residency: us | in
REGION=us

# --- auth and crypto (Auth.js shares AUTH_SECRET; generate with `openssl rand -base64 32`)
AUTH_SECRET=dev-only-change-me
FIELD_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- contact shown in User-Agent and notices
CONTACT_EMAIL=ops@example.com

# --- third-party keys (leave empty locally; tests never call the network)
SAM_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM model classes (SPEC section 8). Only config.py may hold these literals.
LLM_MODEL_OPUS_CLASS=claude-opus-5
LLM_MODEL_SONNET_CLASS=claude-sonnet-5
LLM_MODEL_HAIKU_CLASS=claude-haiku-4-5-20251001
LLM_MODEL_RATIONALE=claude-sonnet-5

# --- embeddings (voyage | fake), 1024 dims
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# --- money: JSON map of currency -> USD rate
FX_RATES={"USD": 1.0, "INR": 0.012}

# --- seed (make seed)
SEED_ADMIN_EMAIL=admin@example.com

# --- observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
