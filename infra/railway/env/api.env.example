# ============================================================================
# Railway service: api   (BIDRADAR_MODE=api, upload root backend/, port 8080)
# ============================================================================
# Copy to api.env, fill in the <...> values, then:
#     scripts/railway/set_vars.sh api infra/railway/env/api.env
#
# `${{Service.VAR}}` is Railway's REFERENCE syntax: the platform substitutes it at
# deploy time, so the Postgres password is never copied into a second place and never
# goes stale when the database is re-provisioned. Leave those lines verbatim.
# Lines starting with # and blank lines are ignored by set_vars.sh.

# --- runtime ---------------------------------------------------------------
BIDRADAR_MODE=api
APP_ENV=production
LOG_LEVEL=INFO
PORT=8080
REGION=us
TRUST_PROXY_HEADERS=true

# --- database --------------------------------------------------------------
# Railway's Postgres plugin publishes ONE DSN, the superuser one. That is our OWNER
# role (migrations, the audited admin bypass). It arrives as
#   postgresql://postgres:<pw>@postgres.railway.internal:5432/railway
# and app/core/config.py normalises postgres:// and postgresql:// to
# postgresql+asyncpg:// and ?sslmode= to ?ssl= on the way in. The INTERNAL hostname is
# on the project's private network and needs no TLS, so no sslmode is set here.
DATABASE_URL_OWNER=${{Postgres.DATABASE_URL}}
# The application role is NOT the owner: NOBYPASSRLS, so an RLS policy can never be
# skipped by accident. `migrate` creates it (app/jobs/bootstrap_db.py) with this
# password, and DATABASE_URL must carry the same one. Generate with
#   openssl rand -hex 24
APP_DB_PASSWORD=<openssl rand -hex 24>
DATABASE_URL=postgresql+asyncpg://bidradar_app:<same APP_DB_PASSWORD>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
# Create the extensions, the role and its grants before `alembic upgrade head`.
# Set to 0 once the role exists and you would rather the deploy role not have CREATE ROLE.
BOOTSTRAP_DB=1
# ONLY this service migrates. backend/railway.json gives api, worker and beat the same
# preDeployCommand; the other two leave RUN_MIGRATIONS unset and their hook exits 0.
RUN_MIGRATIONS=1
# Runs `python -m app.seed` after the migration, idempotently. Its JSON line carries
# internal_tenant_id — read it with `railway logs --service api` and paste it into the
# front end's BIDRADAR_DEV_TENANT_ID. Can be left on; it does nothing on later deploys.
SEED_ON_START=1
SEED_ADMIN_EMAIL=<you@example.com>

# --- cache / queue ---------------------------------------------------------
REDIS_URL=${{Redis.REDIS_URL}}
# false = real Celery through Redis. The worker service is what runs the tasks.
CELERY_TASK_ALWAYS_EAGER=false

# --- object storage --------------------------------------------------------
# Railway has NO object store. Two options, and they are not equivalent:
#
# (a) RECOMMENDED — Cloudflare R2 (S3 API, no egress fee) or AWS S3. api and worker
#     both reach it over the network, so an upload the API stored is readable by the
#     worker that parses it. This is the only option that survives more than one replica.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=<r2 access key id>
S3_SECRET_KEY=<r2 secret access key>
S3_BUCKET_US=bidradar-us
S3_BUCKET_IN=bidradar-in
SIGNED_URL_EXPIRES_SECONDS=900
#
# (b) DEMO ONLY — a Railway volume. `railway volume add --service api --mount-path /data`
#     then STORAGE_BACKEND=local and LOCAL_STORAGE_ROOT=/data. A Railway volume attaches
#     to EXACTLY ONE service and cannot be mounted twice, so the worker would not see a
#     file the api wrote: document uploads would parse as missing. It also pins the
#     service to one replica. Use it only for a single-service click-through demo.
# STORAGE_BACKEND=local
# LOCAL_STORAGE_ROOT=/data

# --- uploads ---------------------------------------------------------------
# ClamAV needs ~1 GB of RAM for the signature database and a freshclam download on every
# cold start, which is more than the whole demo costs. noop skips the scan — acceptable
# only because nothing untrusted is uploaded in a demo. Turn it back to clamav for real
# tenants (SPEC 11) and size the container accordingly.
SCANNER_BACKEND=noop
OCR_BACKEND=tesseract
OCR_LANGUAGES=eng+hin

# --- auth / crypto ---------------------------------------------------------
# Shared with the frontend, which signs the bearer tokens this API verifies (HS256).
# A shared variable means one value for both services: define AUTH_SECRET once under
# the project's Shared Variables and reference it here and in frontend.env.
AUTH_SECRET=${{shared.AUTH_SECRET}}
# base64 of 32 random bytes: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=<openssl rand -base64 32>

# --- CORS ------------------------------------------------------------------
# The browser never calls this API directly (the front end proxies every request
# same-origin), so this list exists for direct API clients only. Keep it exact.
CORS_ORIGINS=https://<frontend-domain>.up.railway.app

# --- app URLs (deep links in notifications) --------------------------------
APP_BASE_URL=https://<frontend-domain>.up.railway.app
API_BASE_URL=https://<api-domain>.up.railway.app

# --- LLM and embeddings ----------------------------------------------------
ANTHROPIC_API_KEY=<sk-ant-...>
LLM_MODEL_OPUS_CLASS=claude-opus-5
LLM_MODEL_SONNET_CLASS=claude-sonnet-5
LLM_MODEL_HAIKU_CLASS=claude-haiku-4-5
LLM_MODEL_RATIONALE=claude-sonnet-5
# voyage needs a key; `fake` is deterministic, offline and free — fine for a demo, but
# the vectors are meaningless, so semantic search results will be nonsense.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=<pa-...>
# EMBEDDING_PROVIDER=fake

# --- email -----------------------------------------------------------------
# There is no Mailpit on Railway. sendgrid sends real mail; memory swallows it and makes
# it readable only through the API's own outbox, which is enough to click through a demo.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<SG....>
EMAIL_FROM=alerts@<your-domain>
EMAIL_FROM_NAME=BidRadar
EMAIL_POSTAL_ADDRESS=<CAN-SPAM requires a real postal address>
# EMAIL_PROVIDER=memory

# --- sources ---------------------------------------------------------------
# Optional. Without it the SAM.gov adapter is disabled and the demo runs on the Indian
# portals and whatever is already in the database.
SAM_API_KEY=<sam.gov key>
SAM_DAILY_QUOTA=10

# --- compliance ------------------------------------------------------------
CONTACT_EMAIL=<ops@your-domain>

# --- observability (all optional; empty means off) -------------------------
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
