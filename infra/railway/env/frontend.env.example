# ============================================================================
# Railway service: frontend   (upload root frontend/, port 3000)
# ============================================================================
#     scripts/railway/set_vars.sh frontend infra/railway/env/frontend.env

# --- Auth.js ---------------------------------------------------------------
# The SAME secret the API verifies bearer tokens with (HS256). Define it once under the
# project's Shared Variables so the two services cannot drift.
AUTH_SECRET=${{shared.AUTH_SECRET}}
# Public URL of this app; magic-link callbacks are built from it. Fill it in after
# `railway domain --service frontend` prints the generated domain.
AUTH_URL=https://<frontend-domain>.up.railway.app
# Not on Vercel, so Auth.js must be told to trust the Host header the proxy sets.
AUTH_TRUST_HOST=true

# --- Backend --------------------------------------------------------------
# THE IMPORTANT ONE (OQ-77). `API_URL` is a plain runtime variable the Next server
# reads on every proxied request, so the image needs no rebuild to point at a different
# API. `railway up` cannot pass a Docker build argument at all, which is why the
# build-time NEXT_PUBLIC_* path is only a fallback.
#
# RAILWAY_PRIVATE_DOMAIN is the api service's private IPv6 hostname; traffic over it
# never leaves the project and is not billed as egress. Port 8080 is the api's PORT.
API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080
# Inlined into the bundle at build time; only used if API_URL is unset. Harmless to set.
NEXT_PUBLIC_API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080

# --- UI --------------------------------------------------------------------
NEXT_PUBLIC_REGION=US

# --- Membership stub (OQ-11) ----------------------------------------------
# resolveMembership() in src/auth.config.ts does not ask the backend who the signed-in
# user is yet; it reads these two. The uuid is the internal tenant the seed created —
# take it from the api service's deploy log:
#     railway logs --service api | grep internal_tenant_id
# Until this is set, every signed-in user has tenant_id null and sees nothing.
BIDRADAR_DEV_TENANT_ID=<internal_tenant_id from the api deploy log>
BIDRADAR_DEV_ROLE=tenant_owner

# --- DEMO-ONLY sign-in -----------------------------------------------------
# A fresh Railway project has no OAuth client and no SMTP, so without this every
# control on /signin is disabled and nobody can get in. AUTH_DEV_LOGIN=1 registers an
# Auth.js Credentials provider that issues a session to any address below, WITH NO
# PASSWORD and no proof the person owns it. Both variables are required; the flag
# alone registers nothing, and an empty list admits nobody rather than everybody.
# The page shows a "demo mode" badge whenever it is live.
# Delete both and configure Google/Microsoft before anything real signs in.
AUTH_DEV_LOGIN=1
AUTH_DEV_LOGIN_EMAILS=<you@example.com>

# --- Email magic link (optional) ------------------------------------------
# Leave both unset to hide the magic-link form and sign in with an OAuth provider only.
# Note the in-memory Auth.js adapter (src/lib/auth-adapter.ts) is dev-only: magic-link
# sessions do not survive a redeploy.
# EMAIL_SERVER=smtp://apikey:<SG....>@smtp.sendgrid.net:587
# EMAIL_FROM=BidRadar <no-reply@your-domain>

# --- OAuth providers (optional; empty hides the button) --------------------
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=
