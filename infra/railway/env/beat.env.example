# ============================================================================
# Railway service: beat   (BIDRADAR_MODE=beat, upload root backend/)
# ============================================================================
#     scripts/railway/set_vars.sh beat infra/railway/env/beat.env
#
# Celery beat is the scheduler, not a worker: it enqueues, it never executes. It must
# run at EXACTLY ONE replica (backend/railway.json pins numReplicas to 1) — two beats
# would fire every schedule twice, which means every adapter polls twice and every
# digest is sent twice.
#
# It needs far less than the worker: no object store, no LLM key, no email provider,
# because it does not touch a document, a model or a mailbox. It does need the database
# (the schedule is read from it) and Redis (the queue it pushes onto).

BIDRADAR_MODE=beat
APP_ENV=production
LOG_LEVEL=INFO
PORT=8080
REGION=us

# RUN_MIGRATIONS is deliberately ABSENT. Do not add it.
BOOTSTRAP_DB=0

DATABASE_URL_OWNER=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://bidradar_app:<same APP_DB_PASSWORD as api>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
APP_DB_PASSWORD=<same as api>

REDIS_URL=${{Redis.REDIS_URL}}
CELERY_TASK_ALWAYS_EAGER=false
# Railway's filesystem is ephemeral without a volume; the beat schedule file is a cache
# that is rebuilt on start, so /tmp is the right place for it.
CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

SCANNER_BACKEND=noop
AUTH_SECRET=${{shared.AUTH_SECRET}}
FIELD_ENCRYPTION_KEY=<same as api>
CONTACT_EMAIL=<ops@your-domain>
