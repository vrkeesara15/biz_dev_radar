# ============================================================================
# Railway service: worker   (BIDRADAR_MODE=worker, upload root backend/)
# ============================================================================
#     scripts/railway/set_vars.sh worker infra/railway/env/worker.env
#
# The worker runs the SAME image and the SAME backend/railway.json as api. The only
# differences that matter are below: the mode, and the fact that RUN_MIGRATIONS is NOT
# set, so the shared preDeployCommand prints "skipping" and exits 0 instead of racing
# api for the alembic lock.

BIDRADAR_MODE=worker
APP_ENV=production
LOG_LEVEL=INFO
# The worker has no HTTP app, but backend/railway.json healthchecks /healthz for every
# backend service, so the entrypoint starts app/jobs/health_server.py on this port.
PORT=8080
REGION=us

# RUN_MIGRATIONS is deliberately ABSENT. Do not add it.
# SEED_ON_START is deliberately ABSENT. Do not add it.
BOOTSTRAP_DB=0

DATABASE_URL_OWNER=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://bidradar_app:<same APP_DB_PASSWORD as api>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
APP_DB_PASSWORD=<same as api>

REDIS_URL=${{Redis.REDIS_URL}}
CELERY_TASK_ALWAYS_EAGER=false
CELERY_QUEUES=bidradar
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100

# MUST match api exactly: the worker parses documents the API stored. With the volume
# alternative (STORAGE_BACKEND=local) it CANNOT — a Railway volume mounts to one
# service only, so the worker would find every uploaded file missing.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=<r2 access key id>
S3_SECRET_KEY=<r2 secret access key>
S3_BUCKET_US=bidradar-us
S3_BUCKET_IN=bidradar-in

SCANNER_BACKEND=noop
OCR_BACKEND=tesseract
OCR_LANGUAGES=eng+hin

AUTH_SECRET=${{shared.AUTH_SECRET}}
FIELD_ENCRYPTION_KEY=<same as api>

APP_BASE_URL=https://<frontend-domain>.up.railway.app
API_BASE_URL=https://<api-domain>.up.railway.app

ANTHROPIC_API_KEY=<sk-ant-...>
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=<pa-...>

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<SG....>
EMAIL_FROM=alerts@<your-domain>
EMAIL_POSTAL_ADDRESS=<CAN-SPAM requires a real postal address>

SAM_API_KEY=<sam.gov key>
CONTACT_EMAIL=<ops@your-domain>
